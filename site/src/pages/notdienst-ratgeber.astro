        <span class="fact-num">noctu</span>
        <span class="fact-label">Kassenübernahme bei ärztlicher Dringlichkeit</span>
      </div>
    </div>

    <!-- In-Content Ad -->
    <div class="my-3">
      <AdSlot slot="4567890123" />
    </div>

    <!-- Table of Contents -->
    <div class="toc-box my-3">
