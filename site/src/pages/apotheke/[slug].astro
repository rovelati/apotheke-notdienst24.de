---
import Base from '../../layouts/Base.astro';
import LiveDateBadge from '../../components/LiveDateBadge.astro';
import AdSlot from '../../components/AdSlot.astro';
import bundeslaenderData from '../../data/bundeslaender.json';

export async function getStaticPaths() {
  const allShards = import.meta.glob('../../data/shards/*.json', { eager: true });
  const paths: any[] = [];

  for (const b of bundeslaenderData) {
    const shardKey = `../../data/shards/${b.slug}.json`;
    const mod: any = allShards[shardKey];
    const pharms: any[] = mod ? (mod.default || mod) : [];

    for (const p of pharms) {
      paths.push({
        params: { slug: p.slug },
        props: {
          pharmacy: p,
          bundesland: b
        }
      });
    }
  }

  return paths;
}

const { pharmacy, bundesland } = Astro.props;

const mapUrl = (pharmacy.lat && pharmacy.lon)
  ? `https://www.google.com/maps/dir/?api=1&destination=${pharmacy.lat},${pharmacy.lon}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(pharmacy.name + ' ' + pharmacy.strasse + ' ' + pharmacy.plz + ' ' + pharmacy.ort)}`;

function slugify(text: string): string {
  return text.toLowerCase()
    .replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')
    .replace(/[^\w\s-]/g, '').trim().replace(/[-\s]+/g, '-');
}

const citySlug = slugify(pharmacy.ort);
const kammerPortalUrl = bundesland.verifiedPortalUrl || pharmacy.kammerPortalUrl || 'https://www.aponet.de/apotheke/notdienstsuche';

// Schema.org Pharmacy
const pharmacyLd: any = {
  "@context": "https://schema.org",
  "@type": "Pharmacy",
  "name": pharmacy.name,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": pharmacy.strasse,
    "addressLocality": pharmacy.ort,
    "postalCode": pharmacy.plz,
    "addressCountry": "DE"
  },
  "url": `https://www.apotheke-notdienst24.de/apotheke/${pharmacy.slug}/`,
  "telephone": pharmacy.telephone || "+49 116 117"
};

if (pharmacy.lat && pharmacy.lon) {
  pharmacyLd.geo = {
    "@type": "GeoCoordinates",
    "latitude": pharmacy.lat,
    "longitude": pharmacy.lon
  };
}
---

<Base
  title={`${pharmacy.name} in ${pharmacy.ort} (${pharmacy.plz}): Kontaktdaten, Öffnungszeiten, Notdienst-Info | Apotheke-Notdienst24.de`}
  description={`Adresse, Telefonnummer und Notdienst-Informationen für ${pharmacy.name} in ${pharmacy.strasse}, ${pharmacy.plz} ${pharmacy.ort}. Bitte vorab anrufen oder beim Kammer-Portal prüfen.`}
  breadcrumbs={[
    { name: "Bundesländer", href: "/apotheken-notdienst/" },
    { name: bundesland.name, href: `/apotheken-notdienst/${bundesland.slug}/` },
    { name: pharmacy.ort, href: `/apotheken-notdienst/${bundesland.slug}/${citySlug}/` },
    { name: pharmacy.name, href: `/apotheke/${pharmacy.slug}/` }
  ]}
  jsonLd={pharmacyLd}
>
  <div class="wrap my-4">
    <LiveDateBadge prefix={`Apothekenprofil:`} />

    <div class="pharma-profile-card">
      <div class="profile-header">
        <div class="status-badge-wrap">
          <span class="badge badge-normal">
            Apotheke
          </span>
        </div>

        <h1 class="pharma-title">{pharmacy.name}</h1>
        <p class="pharma-lead">
          Apotheke in <strong>{pharmacy.ort}</strong> ({pharmacy.plz}), {bundesland.name}.
        </p>
      </div>

      <div class="profile-actions-bar">
        {pharmacy.telephone ? (
          <a href={`tel:${pharmacy.telephone.replace(/\s+/g, '')}`} class="btn btn-call btn-lg">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
            </svg>
            <span>Vor Anfahrt anrufen: {pharmacy.telephone}</span>
          </a>
        ) : (
          <a href="tel:116117" class="btn btn-call btn-call-generic btn-lg">
            <span>116 117 anrufen</span>
          </a>
        )}

        <a href={`https://www.aponet.de/notdienstsuche/${pharmacy.plz}`} target="_blank" rel="noopener noreferrer nofollow" class="btn btn-aponet btn-lg" title={`Offizielle Notdienstsuche für PLZ ${pharmacy.plz} auf aponet.de`}>
          <span>Notdienst auf aponet.de (PLZ {pharmacy.plz}) ↗</span>
        </a>

        <a href={kammerPortalUrl} target="_blank" rel="noopener noreferrer nofollow" class="btn btn-kammer btn-lg">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>Kammer-Portal ({bundesland.code}) ↗</span>
        </a>

        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn-route btn-lg">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
          <span>Route</span>
        </a>
      </div>

      <div class="profile-grid">
        <!-- Details Left -->
        <div class="profile-col">
          <h2 class="sub-title">Adresse & Standort</h2>
          <div class="info-box">
            <p><strong>Straße:</strong> {pharmacy.strasse}</p>
            <p><strong>PLZ & Ort:</strong> {pharmacy.plz} {pharmacy.ort}</p>
            <p><strong>Bundesland:</strong> {bundesland.name}</p>
            {pharmacy.googleWebsite && (
              <p><strong>Webseite:</strong> <a href={pharmacy.googleWebsite} target="_blank" rel="nofollow noopener">{pharmacy.googleWebsite}</a></p>
            )}
          </div>

          <h2 class="sub-title my-3">Reguläre Öffnungszeiten</h2>
          <div class="info-box">
            {pharmacy.openingHours && pharmacy.openingHours.length > 0 ? (
              <ul class="hours-list">
                {pharmacy.openingHours.map((h: string) => (
                  <li>{h}</li>
                ))}
              </ul>
            ) : (
              <p>Montag bis Freitag: 08:30 – 18:30 Uhr<br/>Samstag: 09:00 – 13:00 Uhr</p>
            )}
          </div>
        </div>

        <!-- Details Right: Notdienst Auskunft -->
        <div class="profile-col">
          <h2 class="sub-title">Apotheken-Notdienst & Bereitschaft</h2>
          <div class="info-box notdienst-box">
            <div class="kammer-card">
              <div class="kammer-badge">🏛️ {bundesland.kammerName || 'Zuständige Landesapothekerkammer'}</div>
              <p class="kammer-text">
                Der Notdienst in <strong>{pharmacy.ort}</strong> und ganz {bundesland.name} wird gemäß § 23 Apothekenbetriebsordnung (ApBetrO) tagesaktuell durch die Landesapothekerkammer geregelt.
              </p>
              <div class="kammer-action-wrap">
                <a href={kammerPortalUrl} target="_blank" rel="noopener noreferrer nofollow" class="btn-kammer-portal">
                  <span>Zur verbindlichen Notdienst-Suche der Kammer ↗</span>
                </a>
              </div>
            </div>

            <div class="alert-safety my-3">
              <strong>⚠️ Wichtiger Hinweis für Patienten:</strong>
              <p>
                Notdienst-Einteilungen können kurzfristig wechseln (z. B. krankheitsbedingt). <strong>Rufen Sie die Apotheke bitte vor Fahrtantritt unter {pharmacy.telephone || 'der Notfallnummer 116 117'} an</strong>, um die tatsächliche Notdienstbereitschaft abzuklären.
              </p>
              <p class="fee-notice">
                Außerhalb der regulären Ladenöffnungszeiten fällt die gesetzliche Notdienstgebühr in Höhe von <strong>2,50 €</strong> an (§ 6 AMPreisV), es sei denn, ein dringendes Rezept ist mit dem Vermerk „noctu“ gekennzeichnet.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Ad Slot -->
    <div class="my-4">
      <AdSlot slot="9012345678" />
    </div>
  </div>
</Base>

<style>
  .pharma-profile-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
  }
  .pharma-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 900;
    margin: 0.6rem 0 0.4rem;
    color: var(--ink);
  }
  .pharma-lead {
    font-size: 1.1rem;
    color: var(--ink-secondary);
    margin: 0 0 1.5rem;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .badge-24h {
    background: #059669;
    color: #ffffff;
  }
  .badge-normal {
    background: var(--surface-2);
    color: var(--muted);
    border: 1px solid var(--line);
  }
  .profile-actions-bar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .btn-lg {
    padding: 12px 20px;
    font-size: 1rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.15s ease;
  }
  .btn-call {
    background: #dc2626;
    color: #ffffff;
    flex: 1.2;
    min-width: 220px;
  }
  .btn-call:hover {
    background: #b91c1c;
    text-decoration: none;
  }
  .btn-aponet {
    background: #dc2626;
    color: #ffffff;
    flex: 1.2;
    min-width: 220px;
  }
  .btn-aponet:hover {
    background: #b91c1c;
    text-decoration: none;
  }
  .btn-call-generic {
    background: #0284c7;
  }
  .btn-kammer {
    background: #1e293b;
    color: #ffffff;
    flex: 1.2;
    min-width: 220px;
  }
  .btn-kammer:hover {
    background: #0f172a;
    text-decoration: none;
  }
  .btn-route {
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    flex: 0.8;
    min-width: 140px;
  }
  .btn-route:hover {
    background: var(--surface-hover);
    text-decoration: none;
  }
  .profile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 768px) {
    .profile-grid {
      grid-template-columns: 1fr;
    }
  }
  .sub-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 0.8rem;
  }
  .info-box {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.4rem;
  }
  .info-box p {
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    color: var(--ink-secondary);
  }
  .info-box p:last-child {
    margin-bottom: 0;
  }
  .hours-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.92rem;
    color: var(--ink-secondary);
  }
  .kammer-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 14px;
    margin-bottom: 1rem;
  }
  :global([data-theme="dark"]) .kammer-card {
    background: var(--surface);
  }
  .kammer-badge {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .kammer-text {
    font-size: 0.88rem;
    color: var(--ink-secondary);
    line-height: 1.45;
    margin: 0 0 10px;
  }
  .btn-kammer-portal {
    display: inline-block;
    background: #0284c7;
    color: #ffffff;
    padding: 9px 14px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .btn-kammer-portal:hover {
    background: #0369a1;
    text-decoration: none;
  }
  .alert-safety {
    background: #fff1f2;
    border-left: 4px solid #dc2626;
    padding: 12px 14px;
    border-radius: 4px;
    color: #881337;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .alert-safety p {
    margin: 0 0 6px;
    color: #881337;
  }
  .fee-notice {
    font-size: 0.82rem;
    color: #9f1239;
    margin-top: 6px;
  }
</style>
