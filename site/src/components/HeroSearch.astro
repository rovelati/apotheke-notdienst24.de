---
export interface Props {
  placeholder?: string;
}
const { placeholder = "PLZ oder Stadt eingeben (z.B. 10115, Berlin, München, Köln...)" } = Astro.props;
---
<div class="search-hero-box">
  <form id="hero-search-form" class="search-form" action="/in-meiner-naehe/" method="GET" onsubmit="return false;">
    <div class="search-input-wrapper">
      <svg class="search-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
      <input
        type="search"
        id="hero-search-input"
        placeholder={placeholder}
        autocomplete="off"
        aria-label="Notdienst-Apotheke nach PLZ oder Stadt suchen"
      />
      <button type="button" id="clear-search-btn" class="clear-btn" aria-label="Suche leeren" style="display:none;">
        ✕
      </button>
    </div>
    
    <div class="search-actions">
      <button type="button" id="geo-btn-hero" class="btn btn-primary btn-geo">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 2v3m0 14v3M2 12h3m14 0h3"/>
        </svg>
        <span>In meiner Nähe</span>
      </button>
    </div>

    <!-- Autocomplete results dropdown -->
    <div id="search-suggestions" class="search-dropdown" style="display: none;"></div>
  </form>
</div>

<style>
  .search-hero-box {
    position: relative;
    max-width: 680px;
    margin: 1.5rem auto 1rem;
    width: 100%;
  }
  .search-form {
    display: flex;
    gap: 8px;
    position: relative;
  }
  .search-input-wrapper {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: 16px;
    color: var(--muted);
    pointer-events: none;
  }
  #hero-search-input {
    width: 100%;
    padding: 14px 44px 14px 48px;
    font-size: 1.05rem;
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--ink);
    border: 2px solid var(--line);
    box-shadow: var(--shadow-md);
    transition: all 0.2s ease;
  }
  #hero-search-input:focus {
    outline: none;
    border-color: #dc2626;
    box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.15);
  }
  .clear-btn {
    position: absolute;
    right: 14px;
    background: transparent;
    border: none;
    color: var(--muted);
    font-size: 1rem;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: var(--radius-full);
  }
  .clear-btn:hover {
    color: var(--ink);
  }
  .btn-geo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #dc2626;
    color: #ffffff;
    border: none;
    padding: 0 20px;
    border-radius: var(--radius-full);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    white-space: nowrap;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .btn-geo:hover {
    background: #b91c1c;
    transform: scale(1.02);
  }
  .search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    max-height: 340px;
    overflow-y: auto;
    z-index: 100;
  }
  @media (max-width: 600px) {
    .search-form {
      flex-direction: column;
    }
    .btn-geo {
      height: 48px;
      justify-content: center;
    }
  }
</style>

<script is:inline>
  (function() {
    let citiesIndex = null;

    async function loadCities() {
      if (citiesIndex) return citiesIndex;
      try {
        const res = await fetch('/api/orte.json');
        if (res.ok) {
          citiesIndex = await res.json();
        }
      } catch (e) {
        citiesIndex = [];
      }
      return citiesIndex || [];
    }

    const input = document.getElementById('hero-search-input');
    const dropdown = document.getElementById('search-suggestions');
    const clearBtn = document.getElementById('clear-search-btn');
    const geoBtn = document.getElementById('geo-btn-hero');

    if (!input || !dropdown) return;

    input.addEventListener('focus', () => loadCities());

    input.addEventListener('input', async (e) => {
      const q = e.target.value.trim().toLowerCase();
      if (clearBtn) clearBtn.style.display = q ? 'block' : 'none';

      if (q.length < 2) {
        dropdown.style.display = 'none';
        dropdown.innerHTML = '';
        return;
      }

      const cities = await loadCities();
      const matches = cities.filter(c => {
        if (c.name.toLowerCase().includes(q)) return true;
        if (c.slug.includes(q)) return true;
        if (c.plz_list && c.plz_list.some(p => p.startsWith(q))) return true;
        return false;
      }).slice(0, 8);

      if (matches.length === 0) {
        dropdown.innerHTML = '<div style="padding:14px;color:var(--muted);text-align:center;font-size:0.9rem;">Keine Stadt oder PLZ gefunden.</div>';
        dropdown.style.display = 'block';
        return;
      }

      dropdown.innerHTML = matches.map(c => `
        <a href="/apotheken-notdienst/${c.bundesland_slug}/${c.slug}/" style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink);transition:background 0.1s ease;">
          <div>
            <strong style="font-size:0.98rem;">${c.name}</strong>
            <span style="font-size:0.82rem;color:var(--muted);margin-left:6px;">(${c.bundesland_name})</span>
          </div>
          <span style="font-size:0.78rem;background:var(--surface-2);color:var(--ink-secondary);padding:3px 8px;border-radius:12px;font-weight:600;">
            ${c.plz_list ? c.plz_list.slice(0, 3).join(', ') : ''}
          </span>
        </a>
      `).join('');
      dropdown.style.display = 'block';
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        input.value = '';
        clearBtn.style.display = 'none';
        dropdown.style.display = 'none';
        input.focus();
      });
    }

    if (geoBtn) {
      geoBtn.addEventListener('click', () => {
        window.location.href = '/in-meiner-naehe/';
      });
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('#hero-search-form')) {
        dropdown.style.display = 'none';
      }
    });
  })();
</script>
