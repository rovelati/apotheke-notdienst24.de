---
export interface Props {
  pharmacy: {
    name: string;
    strasse: string;
    plz: string;
    ort: string;
    lat: number | null;
    lon: number | null;
    telephone?: string;
  };
  bundeslandName?: string;
}

const { pharmacy, bundeslandName = "Deutschland" } = Astro.props;

const hasCoords = pharmacy.lat != null && pharmacy.lon != null && !isNaN(pharmacy.lat) && !isNaN(pharmacy.lon);
const lat = hasCoords ? Number(pharmacy.lat) : 0;
const lon = hasCoords ? Number(pharmacy.lon) : 0;

const latFormatted = hasCoords ? lat.toFixed(6) : "";
const lonFormatted = hasCoords ? lon.toFixed(6) : "";
const coordsString = hasCoords ? `${latFormatted}, ${lonFormatted}` : "";

// Navigation URLs
const googleMapsDirUrl = hasCoords
  ? `https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(pharmacy.name + ' ' + pharmacy.strasse + ' ' + pharmacy.plz + ' ' + pharmacy.ort)}`;

const appleMapsDirUrl = hasCoords
  ? `https://maps.apple.com/?daddr=${lat},${lon}&dirflg=d`
  : `https://maps.apple.com/?q=${encodeURIComponent(pharmacy.name + ' ' + pharmacy.strasse + ' ' + pharmacy.plz + ' ' + pharmacy.ort)}`;

const osmDirUrl = hasCoords
  ? `https://www.openstreetmap.org/directions?engine=fossgis_osrm_car&route=%3B${lat}%2C${lon}`
  : `https://www.openstreetmap.org/search?query=${encodeURIComponent(pharmacy.strasse + ' ' + pharmacy.plz + ' ' + pharmacy.ort)}`;
---

<div class="map-showcase-card my-4" id="anfahrt">
  <div class="map-showcase-header">
    <div class="header-left">
      <div class="section-tag">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span>Standort & Anfahrt</span>
      </div>
      <h2 class="map-title">Interaktive Karte & Routenplaner</h2>
      <p class="map-address-sub">
        <strong>{pharmacy.name}</strong> · {pharmacy.strasse}, {pharmacy.plz} {pharmacy.ort} ({bundeslandName})
      </p>
    </div>

    {hasCoords && (
      <div class="coords-widget" title="GPS-Koordinaten für Navigationssystem">
        <div class="coords-label">GPS-Koordinaten:</div>
        <div class="coords-pill">
          <code id="coord-display">{coordsString}</code>
          <button
            type="button"
            id="copy-coords-btn"
            class="coords-copy-btn"
            aria-label="Koordinaten in die Zwischenablage kopieren"
            title="In Zwischenablage kopieren"
          >
            <svg id="copy-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
            </svg>
            <span id="copy-btn-text">Kopieren</span>
          </button>
        </div>
      </div>
    )}
  </div>

  {hasCoords ? (
    <div class="map-wrapper">
      <div id="single-pharma-map" class="single-interactive-map" data-lat={lat} data-lon={lon} data-name={pharmacy.name} data-address={`${pharmacy.strasse}, ${pharmacy.plz} ${pharmacy.ort}`}></div>

      <div class="map-overlay-controls">
        <button type="button" id="btn-recenter-map" class="map-glass-btn" title="Auf Apotheke zentrieren">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"/>
            <path d="M12 2v3m0 14v3M2 12h3m14 0h3"/>
          </svg>
          <span>Zentrieren</span>
        </button>

        <button type="button" id="btn-map-fs" class="map-glass-btn" title="Vollbild anzeigen">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
          </svg>
        </button>
      </div>

      <div class="map-footer-bar">
        <div class="map-badge-live">
          <span class="pulse-ring"></span>
          <span class="badge-dot"></span>
          <span>Genauer Standort verifiziert</span>
        </div>
        <div class="map-attr-note">
          Karte: &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap</a> & CARTO
        </div>
      </div>
    </div>
  ) : (
    <div class="no-coords-box">
      <p>Für diese Apotheke liegen aktuell keine genauen GPS-Koordinaten vor.</p>
      <a href={googleMapsDirUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        In Google Maps nach Adresse suchen
      </a>
    </div>
  )}

  <!-- Come arrivarci / Navigation Hub -->
  <div class="directions-hub">
    <div class="directions-header">
      <h3 class="hub-title">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="3 11 22 2 13 21 11 13 3 11"/>
        </svg>
        <span>Wie komme ich hin? (Routenplaner & Navigation)</span>
      </h3>
      <p class="hub-sub">
        Wählen Sie Ihre bevorzugte Navigations-App oder berechnen Sie direkt die Live-Entfernung von Ihrem Standort:
      </p>
    </div>

    <!-- Live Geolocation Distance Tool -->
    <div class="live-route-calculator">
      <div class="calc-top">
        <div class="calc-info">
          <strong>🚗 Route von aktuellem Standort ermitteln</strong>
          <span>Berechnet Fahrzeit & Luftlinie direkt im Browser (DSGVO-konform, kein Server-Tracking).</span>
        </div>
        <button type="button" id="btn-calc-live-route" class="btn-live-gps">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"/>
            <path d="M12 2v3m0 14v3M2 12h3m14 0h3"/>
          </svg>
          <span id="live-route-btn-text">Standort ermitteln & Entfernung berechnen</span>
        </button>
      </div>

      <div id="live-route-result" class="live-route-result" style="display: none;">
        <!-- Filled dynamically by JavaScript -->
      </div>
    </div>

    <!-- 3 Direct App Navigation Options -->
    <div class="nav-apps-grid">
      <a href={googleMapsDirUrl} target="_blank" rel="noopener noreferrer" class="nav-app-card nav-google">
        <div class="app-icon-wrap">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="#ea4335">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
        </div>
        <div class="app-details">
          <span class="app-name">Google Maps</span>
          <span class="app-desc">Routenführung mit Echtzeit-Verkehr & Stauinfos</span>
        </div>
        <span class="app-arrow">↗</span>
      </a>

      <a href={appleMapsDirUrl} target="_blank" rel="noopener noreferrer" class="nav-app-card nav-apple">
        <div class="app-icon-wrap">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="#1e293b">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.85c.65-.79 1.1-1.89.98-2.99-1 .04-2.18.66-2.88 1.48-.61.71-1.14 1.83-1 2.91 1.11.09 2.25-.59 2.9-1.4z"/>
          </svg>
        </div>
        <div class="app-details">
          <span class="app-name">Apple Karten</span>
          <span class="app-desc">Ideal für iPhone, iPad & Mac (Turn-by-Turn)</span>
        </div>
        <span class="app-arrow">↗</span>
      </a>

      <a href={osmDirUrl} target="_blank" rel="noopener noreferrer" class="nav-app-card nav-osm">
        <div class="app-icon-wrap">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="#059669">
            <path d="M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5c0 .28.22.5.5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5c0-.28-.22-.5-.5-.5zM15 19l-6-2.11V5l6 2.11V19z"/>
          </svg>
        </div>
        <div class="app-details">
          <span class="app-name">OpenStreetMap</span>
          <span class="app-desc">Freie Open-Source Navigation & OsmAnd</span>
        </div>
        <span class="app-arrow">↗</span>
      </a>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script is:inline>
  (function initSinglePharmacyMap() {
    function setup() {
      const mapEl = document.getElementById('single-pharma-map');
      if (!mapEl || typeof L === 'undefined') return;

      const lat = parseFloat(mapEl.getAttribute('data-lat'));
      const lon = parseFloat(mapEl.getAttribute('data-lon'));
      const name = mapEl.getAttribute('data-name') || 'Apotheke';
      const address = mapEl.getAttribute('data-address') || '';

      if (isNaN(lat) || isNaN(lon)) return;

      // 1. Initialize Leaflet Map
      const map = L.map('single-pharma-map', {
        scrollWheelZoom: false,
        zoomControl: true,
        attributionControl: false
      }).setView([lat, lon], 16);

      // 2. High-res tile layer: CARTO Voyager with crisp retina support
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        maxZoom: 19,
        subdomains: 'abcd',
        attribution: '&copy; OpenStreetMap contributors &copy; CARTO'
      }).addTo(map);

      // 3. Custom SVG German Apotheken Pin Marker
      const apothekeIcon = L.divIcon({
        className: 'custom-apotheke-marker-pin',
        html: `
          <div class="pin-container">
            <div class="pin-pulse"></div>
            <div class="pin-head">
              <span class="pin-letter">A</span>
            </div>
            <div class="pin-tip"></div>
          </div>
        `,
        iconSize: [40, 52],
        iconAnchor: [20, 48],
        popupAnchor: [0, -44]
      });

      const marker = L.marker([lat, lon], { icon: apothekeIcon }).addTo(map);

      // Rich styled popup
      const popupHtml = `
        <div class="map-popup-card">
          <div class="popup-badge">Apotheke</div>
          <h4 class="popup-title">${name}</h4>
          <p class="popup-addr">${address}</p>
          <div class="popup-coords">GPS: ${lat.toFixed(5)}, ${lon.toFixed(5)}</div>
          <a href="https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}" target="_blank" class="popup-btn">
            Route mit Google Maps ↗
          </a>
        </div>
      `;
      marker.bindPopup(popupHtml, { maxWidth: 280 });

      // 4. Recenter & Fullscreen buttons
      const recenterBtn = document.getElementById('btn-recenter-map');
      if (recenterBtn) {
        recenterBtn.addEventListener('click', () => {
          map.flyTo([lat, lon], 16, { duration: 0.8 });
          marker.openPopup();
        });
      }

      const fsBtn = document.getElementById('btn-map-fs');
      if (fsBtn) {
        fsBtn.addEventListener('click', () => {
          const wrapper = mapEl.closest('.map-wrapper');
          if (!wrapper) return;
          if (!document.fullscreenElement) {
            wrapper.requestFullscreen().catch(() => {});
          } else {
            document.exitFullscreen().catch(() => {});
          }
          setTimeout(() => map.invalidateSize(), 300);
        });
      }

      // 5. Copy GPS Coordinates to Clipboard
      const copyBtn = document.getElementById('copy-coords-btn');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const text = `${lat.toFixed(6)}, ${lon.toFixed(6)}`;
          try {
            await navigator.clipboard.writeText(text);
            const btnText = document.getElementById('copy-btn-text');
            if (btnText) {
              const original = btnText.innerText;
              btnText.innerText = 'Kopiert! ✓';
              copyBtn.classList.add('copied');
              setTimeout(() => {
                btnText.innerText = original;
                copyBtn.classList.remove('copied');
              }, 2000);
            }
          } catch (e) {
            // fallback
            prompt('Koordinaten kopieren:', text);
          }
        });
      }

      // 6. Live Geolocation Route & Distance Calculator
      const calcBtn = document.getElementById('btn-calc-live-route');
      const calcResult = document.getElementById('live-route-result');
      const calcBtnText = document.getElementById('live-route-btn-text');
      let userMarker = null;
      let routeLine = null;

      if (calcBtn && calcResult) {
        calcBtn.addEventListener('click', () => {
          if (!navigator.geolocation) {
            alert('Geolocation wird von Ihrem Browser leider nicht unterstützt.');
            return;
          }

          if (calcBtnText) calcBtnText.innerText = 'Standort wird ermittelt... 🛰️';
          calcBtn.disabled = true;

          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const uLat = pos.coords.latitude;
              const uLon = pos.coords.longitude;

              // Calculate Haversine direct distance in km
              const R = 6371; // Earth radius in km
              const dLat = (lat - uLat) * Math.PI / 180;
              const dLon = (lon - uLon) * Math.PI / 180;
              const a =
                Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(uLat * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
              const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
              const distKm = R * c;

              // Driving estimate (roughly 35 km/h urban average)
              const estMins = Math.max(2, Math.round((distKm / 35) * 60));
              const walkMins = Math.round((distKm / 4.8) * 60);

              // Update/Add user marker on map with blue pulsing icon
              if (userMarker) map.removeLayer(userMarker);
              if (routeLine) map.removeLayer(routeLine);

              const userIcon = L.divIcon({
                className: 'custom-user-marker',
                html: '<div class="user-gps-dot"><div class="user-gps-pulse"></div></div>',
                iconSize: [22, 22],
                iconAnchor: [11, 11]
              });

              userMarker = L.marker([uLat, uLon], { icon: userIcon }).addTo(map);
              userMarker.bindPopup('<b>Ihr aktueller Standort</b>').openPopup();

              // Draw dashed route line between user and pharmacy
              routeLine = L.polyline([[uLat, uLon], [lat, lon]], {
                color: '#dc2626',
                weight: 3.5,
                opacity: 0.85,
                dashArray: '8, 8'
              }).addTo(map);

              // Fit bounds to show both
              map.fitBounds([
                [uLat, uLon],
                [lat, lon]
              ], { padding: [50, 50] });

              // Render Result in UI
              const directNavUrl = `https://www.google.com/maps/dir/?api=1&origin=${uLat},${uLon}&destination=${lat},${lon}`;
              calcResult.innerHTML = `
                <div class="calc-badge-row">
                  <div class="stat-pill highlight">
                    <span class="stat-label">Luftlinie:</span>
                    <strong class="stat-val">${distKm < 1 ? Math.round(distKm * 1000) + ' m' : distKm.toFixed(1) + ' km'}</strong>
                  </div>
                  <div class="stat-pill">
                    <span class="stat-label">Pkw ca.:</span>
                    <strong class="stat-val">~${estMins} Min.</strong>
                  </div>
                  <div class="stat-pill">
                    <span class="stat-label">Fußweg ca.:</span>
                    <strong class="stat-val">~${walkMins} Min.</strong>
                  </div>
                </div>
                <div class="calc-action-row">
                  <a href="${directNavUrl}" target="_blank" rel="noopener noreferrer" class="btn-start-nav">
                    <span>🚀 Navigation von meinem Standort starten</span>
                  </a>
                </div>
              `;
              calcResult.style.display = 'block';

              if (calcBtnText) calcBtnText.innerText = 'Standort aktualisieren';
              calcBtn.disabled = false;
            },
            (err) => {
              let msg = 'Standortfreigabe nicht möglich.';
              if (err.code === 1) msg = 'Standortzugriff wurde im Browser abgelehnt.';
              else if (err.code === 2) msg = 'Standortposition nicht verfügbar.';
              else if (err.code === 3) msg = 'Zeitüberschreitung bei Standortermittlung.';
              alert(msg);
              if (calcBtnText) calcBtnText.innerText = 'Standort ermitteln & Entfernung berechnen';
              calcBtn.disabled = false;
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
          );
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>

<style>
  .map-showcase-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
    overflow: hidden;
  }

  .map-showcase-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 1.75rem 2rem 1.25rem;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(to bottom, var(--surface), var(--surface-2));
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #dc2626;
    background: #fee2e2;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 0.5rem;
  }

  .map-title {
    font-size: 1.55rem;
    font-weight: 900;
    color: var(--ink);
    margin: 0 0 0.3rem;
    letter-spacing: -0.02em;
  }

  .map-address-sub {
    font-size: 0.95rem;
    color: var(--ink-secondary);
    margin: 0;
  }

  /* GPS Coordinates Widget */
  .coords-widget {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .coords-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .coords-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 6px 10px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .coords-pill code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  .coords-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .coords-copy-btn:hover {
    background: #dc2626;
    color: #fff;
    border-color: #dc2626;
  }

  .coords-copy-btn.copied {
    background: #059669;
    color: #fff;
    border-color: #059669;
  }

  /* Map Viewport & Overlay */
  .map-wrapper {
    position: relative;
    width: 100%;
  }

  .single-interactive-map {
    height: 420px;
    width: 100%;
    background: #e2e8f0;
    z-index: 1;
  }

  .map-overlay-controls {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    gap: 8px;
    z-index: 400;
  }

  .map-glass-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(0, 0, 0, 0.15);
    color: #0f172a;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 7px 12px;
    border-radius: var(--radius-md);
    cursor: pointer;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: all 0.15s ease;
  }

  .map-glass-btn:hover {
    background: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 12px -2px rgba(0, 0, 0, 0.15);
  }

  .map-footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background: var(--surface);
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .map-badge-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    position: relative;
    font-weight: 700;
    color: #059669;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: #059669;
    border-radius: 50%;
  }

  .pulse-ring {
    position: absolute;
    left: -2px;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid #059669;
    animation: ring-pulse 1.8s infinite;
  }

  @keyframes ring-pulse {
    0% { transform: translateY(-50%) scale(0.8); opacity: 1; }
    100% { transform: translateY(-50%) scale(2); opacity: 0; }
  }

  .map-attr-note a {
    color: var(--ink-secondary);
