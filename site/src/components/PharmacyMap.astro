---
export interface Props {
  pharmacies: Array<{
    id?: string;
    name: string;
    slug?: string;
    strasse: string;
    plz: string;
    ort: string;
    lat: number | null;
    lon: number | null;
    telephone: string;
    isOpen24h?: boolean;
    googleRating?: number | null;
    googleReviewsTotal?: number;
    shifts?: Array<{ type: string; debut: string; fin: string; gebuehr?: string; notes: string }>;
  }>;
  center?: [number, number];
  zoom?: number;
  cityName?: string;
  defaultOnlyOpen?: boolean;
}

const {
  pharmacies,
  center = [51.1657, 10.4515], // Center of Germany
  zoom = 12,
  cityName = "",
  defaultOnlyOpen = true
} = Astro.props;

const now = new Date();

// Filter pharmacies with valid lat/lon
const validPharmacies = pharmacies.filter(p => p.lat && p.lon && !isNaN(p.lat) && !isNaN(p.lon));

const mappedData = validPharmacies.map(p => {
  const is24h = Boolean(p.isOpen24h);
  const activeShift = (p.shifts || []).find(s => {
    const d = new Date(s.debut);
    const f = new Date(s.fin);
    return now >= d && now <= f;
  });
  const isNotdienst = is24h || Boolean(activeShift);

  return {
    id: p.id || p.slug || Math.random().toString(),
    name: p.name,
    slug: p.slug || '',
    strasse: p.strasse,
    plz: p.plz,
    ort: p.ort,
    lat: p.lat,
    lon: p.lon,
    tel: p.telephone,
    isNotdienst,
    is24h,
    rating: p.googleRating,
    reviewsCount: p.googleReviewsTotal,
    gebuehr: activeShift ? activeShift.gebuehr : '',
    shiftNotes: activeShift ? activeShift.notes : ''
  };
});
---

<div class="map-container-box">
  <div class="map-controls-bar">
    <div class="map-filter-group">
      <button type="button" id="toggle-filter-open" class="map-toggle-btn active" data-active="true">
        <span class="toggle-indicator"></span>
        <span class="toggle-text">🔴 Nur JETZT Notdienst ({mappedData.filter(p => p.isNotdienst).length})</span>
      </button>
      <button type="button" id="toggle-filter-all" class="map-toggle-btn" data-active="false">
        <span>Alle Apotheken ({mappedData.length})</span>
      </button>
    </div>

    <div class="map-actions-group">
      <button type="button" id="btn-map-locate" class="map-action-icon-btn" title="Meinen Standort anzeigen" aria-label="Meinen Standort anzeigen">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 2v3m0 14v3M2 12h3m14 0h3"/>
        </svg>
      </button>
      <button type="button" id="btn-map-fullscreen" class="map-action-icon-btn" title="Vollbildmodus" aria-label="Vollbildmodus">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="pharmacy-map" class="interactive-map"></div>

  <div class="map-legend">
    <div class="legend-item">
      <span class="legend-dot dot-red"></span>
      <span>🔴 Jetzt Notdienst / Dauernd geöffnet</span>
    </div>
    <div class="legend-item">
      <span class="legend-dot dot-blue"></span>
      <span>Reguläre Apotheke</span>
    </div>
    <div class="legend-item">
      <span class="legend-dot dot-cluster"></span>
      <span>Cluster (Zahl = Apotheken)</span>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />

<style>
  .map-container-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin: 1.5rem 0 2rem;
    box-shadow: var(--shadow-md);
  }
  .map-controls-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 10px;
  }
  .map-filter-group {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .map-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .map-toggle-btn.active {
    background: #dc2626;
    color: #ffffff;
    border-color: #dc2626;
  }
  .toggle-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffffff;
  }
  .map-actions-group {
    display: flex;
    gap: 6px;
  }
  .map-action-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .map-action-icon-btn:hover {
    background: var(--surface-hover);
  }
  .interactive-map {
    height: 480px;
    width: 100%;
    background: var(--surface-2);
  }
  .map-legend {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 8px 14px;
    background: var(--surface);
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--ink-secondary);
    flex-wrap: wrap;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot-red { background: #dc2626; }
  .dot-blue { background: #0284c7; }
  .dot-cluster { background: #d97706; }

  @media (max-width: 600px) {
    .interactive-map {
      height: 380px;
    }
  }
</style>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>

<script is:inline define:vars={{ mappedData, center, zoom }}>
  (function() {
    function initMap() {
      const el = document.getElementById('pharmacy-map');
      if (!el || typeof L === 'undefined') return;

      const map = L.map('pharmacy-map', {
        scrollWheelZoom: false
      }).setView(center, zoom);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> Mitwirkende',
        maxZoom: 19
      }).addTo(map);

      // Custom SVG icons
      const redIcon = L.divIcon({
        className: 'custom-pin-red',
        html: '<div style="background:#dc2626;color:white;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:16px;box-shadow:0 2px 6px rgba(0,0,0,0.3);border:2px solid white;">A</div>',
        iconSize: [30, 30],
        iconAnchor: [15, 15],
        popupAnchor: [0, -15]
      });

      const blueIcon = L.divIcon({
        className: 'custom-pin-blue',
        html: '<div style="background:#0284c7;color:white;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:14px;box-shadow:0 2px 5px rgba(0,0,0,0.25);border:2px solid white;">A</div>',
        iconSize: [26, 26],
        iconAnchor: [13, 13],
        popupAnchor: [0, -13]
      });

      let clusterGroup = L.markerClusterGroup({
        maxClusterRadius: 40,
        spiderfyOnMaxZoom: true,
        showCoverageOnHover: false
      });
      map.addLayer(clusterGroup);

      let currentOnlyNotdienst = true;

      function renderMarkers() {
        clusterGroup.clearLayers();
        const toShow = currentOnlyNotdienst ? mappedData.filter(p => p.isNotdienst) : mappedData;
        const bounds = [];

        toShow.forEach(p => {
          if (!p.lat || !p.lon) return;
          const marker = L.marker([p.lat, p.lon], {
            icon: p.isNotdienst ? redIcon : blueIcon
          });

          const popupContent = `
            <div style="font-family:system-ui,sans-serif;padding:4px;min-width:200px;">
              <div style="display:inline-block;padding:2px 6px;border-radius:4px;font-size:11px;font-weight:bold;color:white;background:${p.isNotdienst ? '#dc2626' : '#0284c7'};margin-bottom:6px;">
                ${p.is24h ? '24h Dauernd Geöffnet' : p.isNotdienst ? 'JETZT NOTDIENST' : 'Reguläre Apotheke'}
              </div>
              <h4 style="margin:0 0 4px;font-size:14px;font-weight:bold;">${p.name}</h4>
              <p style="margin:0 0 8px;font-size:12px;color:#555;">${p.strasse}, ${p.plz} ${p.ort}</p>
              ${p.rating ? `<div style="font-size:12px;margin-bottom:8px;">★ <strong>${p.rating.toFixed(1)}</strong> (${p.reviewsCount || 0} Bewertungen)</div>` : ''}
              <div style="display:flex;gap:6px;">
                ${p.tel ? `<a href="tel:${p.tel.replace(/\s+/g,'')}" style="flex:1;text-align:center;padding:6px;background:#dc2626;color:white;border-radius:4px;font-size:12px;font-weight:bold;text-decoration:none;">📞 Anrufen</a>` : `<a href="tel:116117" style="flex:1;text-align:center;padding:6px;background:#0284c7;color:white;border-radius:4px;font-size:12px;font-weight:bold;text-decoration:none;">116 117</a>`}
                <a href="https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lon}" target="_blank" style="padding:6px 10px;background:#eee;color:#111;border-radius:4px;font-size:12px;text-decoration:none;font-weight:bold;">Route</a>
              </div>
            </div>
          `;
          marker.bindPopup(popupContent);
          clusterGroup.addLayer(marker);
          bounds.push([p.lat, p.lon]);
        });

        if (bounds.length > 0) {
          map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
        }
      }

      renderMarkers();

      // Filter buttons
      const btnOpen = document.getElementById('toggle-filter-open');
      const btnAll = document.getElementById('toggle-filter-all');

      if (btnOpen && btnAll) {
        btnOpen.addEventListener('click', () => {
          currentOnlyNotdienst = true;
          btnOpen.classList.add('active');
          btnAll.classList.remove('active');
          renderMarkers();
        });
        btnAll.addEventListener('click', () => {
          currentOnlyNotdienst = false;
          btnAll.classList.add('active');
          btnOpen.classList.remove('active');
          renderMarkers();
        });
      }

      // Geolocation
      const btnLocate = document.getElementById('btn-map-locate');
      if (btnLocate) {
        btnLocate.addEventListener('click', () => {
          if (!navigator.geolocation) {
            alert('Standortbestimmung wird von Ihrem Browser nicht unterstützt.');
            return;
          }
          navigator.geolocation.getCurrentPosition(pos => {
            const userLat = pos.coords.latitude;
            const userLon = pos.coords.longitude;
            map.setView([userLat, userLon], 14);
            L.circleMarker([userLat, userLon], {
              radius: 8,
              fillColor: '#2563eb',
              color: '#ffffff',
              weight: 2,
              opacity: 1,
              fillOpacity: 0.9
            }).addTo(map).bindPopup('Ihr aktueller Standort').openPopup();
          }, () => {
            alert('Standort konnte nicht ermittelt werden.');
          });
        });
      }

      // Fullscreen
      const btnFs = document.getElementById('btn-map-fullscreen');
      if (btnFs) {
        btnFs.addEventListener('click', () => {
          if (!document.fullscreenElement) {
            el.requestFullscreen().catch(() => {});
          } else {
            document.exitFullscreen().catch(() => {});
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMap);
    } else {
      initMap();
    }
  })();
</script>
