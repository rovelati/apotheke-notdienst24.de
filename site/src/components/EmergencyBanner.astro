---
---
<div class="emergency-bar">
  <div class="wrap emergency-inner">
    <div class="urg-info">
      <span class="urg-icon">🚨</span>
      <span class="urg-title">Akuter Notfall oder dringend Medikamente benötigt?</span>
    </div>
    <div class="urg-actions">
      <a href="tel:116117" class="urg-btn urg-pharma" title="Ärztlicher Bereitschaftsdienst (Kostenfrei)">
        <span class="pulse-dot"></span>
        <strong>116 117</strong> Ärztl. Bereitschaft
      </a>
      <a href="tel:22833" class="urg-btn urg-police" title="Apotheken-Notdienst Hotline (vom Handy 69ct/Min)">
        <strong>22 8 33</strong> Notdienst-Finder
      </a>
      <a href="tel:112" class="urg-btn urg-samu" title="Notruf & Rettungsdienst - Lebensgefahr">
        <strong>112</strong> Notruf
      </a>
    </div>
  </div>
</div>

<style>
  .emergency-bar {
    background: var(--urgent-bg);
    border-bottom: 1px solid var(--urgent-border);
    padding: 8px 0;
  }
  .emergency-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  .urg-info {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--urgent);
  }
  .urg-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .urg-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.85rem;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.1s ease;
  }
  .urg-btn:hover {
    transform: scale(1.04);
    text-decoration: none;
  }
  .urg-pharma {
    background: #0284c7;
    color: #ffffff;
  }
  .urg-police {
    background: var(--gold);
    color: #ffffff;
  }
  .urg-samu {
    background: var(--urgent);
    color: #ffffff;
  }
  @media (max-width: 600px) {
    .urg-title {
      display: none;
    }
    .emergency-inner {
      justify-content: center;
    }
  }
</style>
